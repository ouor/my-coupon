<?xml version="1.0" encoding="utf-8"?>
<!-- widget picker preview (Android 12+), laid out like W1: sample rows only, never real coupons -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_preview_bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name"
        android:textColor="#FF5A6170" android:textSize="13sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="10dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="아메리카노" android:textColor="#FF1A1C20" android:textSize="15sp" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="D-2" android:textColor="#FFC0392B" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="10dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="편의점 5,000원권" android:textColor="#FF1A1C20" android:textSize="15sp" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="D-5" android:textColor="#FFC0392B" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="10dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="베이커리 교환권" android:textColor="#FF1A1C20" android:textSize="15sp" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="D-16" android:textColor="#FF1A1C20" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
